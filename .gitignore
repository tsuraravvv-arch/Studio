# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/assets/hero/*
!/public/assets/hero/tools/
/public/assets/hero/tools/*
!/public/assets/hero/tools/crop-studio-hero.png
/public/assets/cards/
/public/assets/ui/
/public/assets/community/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated reports (regenerated by npm run verify:assets:json)
/public/assets/tsurara/reports/
# incoming Tsurara asset packs are local staging files
/public/assets/tsurara/incoming/*
!/public/assets/tsurara/incoming/README.md
