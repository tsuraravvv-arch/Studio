{
  "name": "tsurara-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-hero.mjs",
    "prebuild": "node scripts/prepare-hero.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:assets": "node scripts/verify-tsurara-assets.mjs",
    "verify:assets:json": "node scripts/verify-tsurara-assets.mjs --out public/assets/tsurara/reports/blink-crop-report.json",
    "import:pack": "node scripts/import-tsurara-pack.mjs",
    "check": "npm run verify:assets:json && npm run lint && npm run build"
  },
  "dependencies": {
    "music-metadata": "^11.15.0",
    "next": "16.3.2",
    "pixi.js": "^8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
